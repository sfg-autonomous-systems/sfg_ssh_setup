; SELinux policy module for the SFG SSH server setup.
;
; Allows sshd to cache the authorized keys fetched by the AuthorizedKeysCommand.
; Fetching the keys via HTTPS is already allowed by the base policy.
;
; Installed as module "sfg_ssh_server" by scripts/set_up_ssh_server
; (semodule derives the module name from the filename).

; Dedicated label for the authorized keys cache, so sshd only gets write access
; to this directory instead of to everything labeled var_t.
(type sfg_ssh_server_cache_t)
(roletype object_r sfg_ssh_server_cache_t)
(typeattributeset file_type (sfg_ssh_server_cache_t))
(filecon "/var/cache/sfg(/.*)?" any (system_u object_r sfg_ssh_server_cache_t ((s0) (s0))))

; Since OpenSSH 9.8, the AuthorizedKeysCommand runs in sshd_session_t (sshd-session).
; Optional, so the module still loads on policies without this type.
(optional sfg_ssh_server_session
    (allow sshd_session_t sfg_ssh_server_cache_t (dir (getattr search open read write add_name remove_name create)))
    (allow sshd_session_t sfg_ssh_server_cache_t (file (getattr open read write create truncate rename unlink)))
)

; Before OpenSSH 9.8, the AuthorizedKeysCommand runs in sshd_t.
(optional sfg_ssh_server_legacy
    (allow sshd_t sfg_ssh_server_cache_t (dir (getattr search open read write add_name remove_name create)))
    (allow sshd_t sfg_ssh_server_cache_t (file (getattr open read write create truncate rename unlink)))
)
